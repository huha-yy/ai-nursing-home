# ============================================================
# AI 养老院院长 MVP — 环境变量模板
# 复制为 infra/.env 并填入实际值
# ============================================================

# Postgres
POSTGRES_USER=dato
POSTGRES_PASSWORD=change_me
POSTGRES_DB=dato

# Caddy
CADDY_HTTPS_PORT=9443
CADDY_DOMAIN=hz-sanfu.eldcare.cn
# CADDY_ACME_EMAIL=admin@example.com

# Redis
REDIS_PORT=6379

# Timezone
TIMEZONE=Asia/Shanghai

# Docker socket proxy
DOCKER_PROXY_PORT=2375

# dl-control — 生成方式:
#   DL_CONTROL_SECRET_KEY=$(openssl rand -base64 24)
#   DL_CONTROL_APP_PASSWORD=$(openssl rand -hex 16)
SESSION_TTL_SECONDS=86400
LOGIN_RATE_LIMIT_FAILS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
DATO_DATA_ROOT=~/.local/share/dato
DL_CONTROL_SECRET_KEY=generate_a_random_secret_key_here
DL_CONTROL_APP_PASSWORD=generate_a_random_password_here

# LLM — 本地模型 (Ollama)
DL_LLM_LOCAL_MODEL=qwen3.5:9b
DL_LLM_LOCAL_KEEP_ALIVE=1800
DL_LLM_LOCAL_MEM=12g
DL_LLM_LOCAL_CPUS=4
DL_LLM_PROXY_RPM=30
COMPOSE_PROFILES=local-llm

# 供应商 LLM (Moonshot/Kimi, OpenAI-compatible — agent 与 chat 共用)
# LLM_API_KEY=sk-your-key-here
# LLM_BASE_URL=https://api.moonshot.cn/v1
# LLM_MODEL=kimi-k2.6

# dl-cognee + 内部服务认证 — 生成方式:
#   DL_COGNEE_ADMIN_TOKEN=$(openssl rand -hex 32)
#   DL_INTERNAL_API_KEY=$(openssl rand -hex 32)
DL_COGNEE_ADMIN_TOKEN=generate_a_random_token_here
DL_INTERNAL_API_KEY=generate_a_random_key_here

# GBrain
# DL_GBRAIN_PG_PASSWORD=$(openssl rand -hex 16)
DL_GBRAIN_PG_PASSWORD=generate_a_random_password_here

# nursing-erp（姊妹仓库 ../nursing-erp，Django ERP）
# Dashboard/Chat 经此地址查询 ERP 的 /api/（需与 nursing-erp/.env 的 ERP_API_KEY 同值）
NURSING_ERP_URL=http://dato-caddy:9081
# NURSING_ERP_API_KEY=$(python3 -c "import secrets; print(secrets.token_urlsafe(36))")
NURSING_ERP_API_KEY=

# huha-crm（宿主机 systemd 服务 /home/huha-crm，端口 8766）
# 公司销售账号登录 chat 时委托 CRM /api/auth 校验；role=company 会话预取 CRM 数据。
# 需与 /home/huha-crm/.env 的 CRM_API_KEY 同值；留空则登录委托 fail-closed。
CRM_API_URL=http://192.168.10.247:8766
# CRM_API_KEY=$(python3 -c "import secrets; print(secrets.token_urlsafe(36))")
CRM_API_KEY=

# dl-ocr（Unlimited-OCR 文字识别，容器名 dl-ocr-unlimited）
# 容器网络内调用地址（dato-control 附件 OCR 用）；宿主机进程（nursing-erp）
# 走宿主端口 http://192.168.10.247:18080。留空则 OCR 端点不设 Bearer 认证。
# DL_OCR_API_TOKEN=$(openssl rand -hex 32)
DL_OCR_URL=http://dl-ocr-unlimited:8080
DL_OCR_API_TOKEN=
