{
    email {$CADDY_ACME_EMAIL:admin@localhost}
    skip_install_trust
    local_certs
}

{$CADDY_DOMAIN:localhost}:{$CADDY_HTTPS_PORT:8443}, localhost:{$CADDY_HTTPS_PORT:8443}, 192.168.10.247:{$CADDY_HTTPS_PORT:8443}, hz-sanfu.eldcare.cn:{$CADDY_HTTPS_PORT:8443} {
    # TLS: real Let's Encrypt certificate (issued via acme.sh + DNSPod API)
    tls /data/caddy/fullchain.pem /data/caddy/privkey.pem

    # Bump upload limit for large requests (file uploads, content pipeline artifacts)
    request_body {
        max_size 128MB
    }

    # P4: structured access log. Agent UUIDs in URIs are public identifiers
    # (already exposed in the admin UI). No redaction needed — the admin UI
    # is behind authentication.
    log {
        output stdout
        format json
    }

    # GBrain MCP API（Agent 飞书查询用）
    @gbrain path /gbrain*
    handle @gbrain {
        reverse_proxy dl-gbrain:8080
    }

    # GBrain admin SPA — 通过独立端口 8444 直接访问
    # （SPA 的 /assets/ 路径与 Caddy 子路径不兼容，
    #  完整版改用独立域名或 GBRAIN_BASE_PATH 环境变量）

    # Health check endpoint (static file)
    @health path /health /health/*
    handle @health {
        root * /srv/healthcheck
        try_files {path} /index.html
        file_server
    }

    # Pitch deck — 对外宣传单页（同一路径内外网均可访问）
    @pitch path /intro /intro/*
    handle @pitch {
        encode zstd gzip
        root * /srv/pitch
        file_server
    }

    # All other traffic → dl-control. Strip client-supplied forwarding
    # headers and overwrite X-Forwarded-For with the real peer so
    # uvicorn --proxy-headers cannot be fed a spoofed client IP.
    handle {
        reverse_proxy dato-control:8080 {
            header_up -Forwarded
            header_up -X-Real-IP
            header_up X-Forwarded-For {remote_host}
        }
    }
}

# Dev HTTP fallback — no TLS, for localhost use when self-signed cert
# warnings are inconvenient. Also the tunnel endpoint for the public
# chat.eldcare.cn:8443 entry (cloud frps :19080 → frpc → this port).
:9080 {
    # Pitch deck — 对外宣传单页（公网入口 chat.eldcare.cn:8443/intro/）
    @pitch path /intro /intro/*
    handle @pitch {
        encode zstd gzip
        root * /srv/pitch
        file_server
    }

    handle {
        reverse_proxy dato-control:8080 {
            header_up -X-Forwarded-Proto
            header_up X-Forwarded-Proto https
        }
    }
}

# nursing-erp: 养老院业务管理系统（开发环境）
# Also the tunnel endpoint for the public admin.eldcare.cn:8443 entry.
:9081 {
    @pitch path /intro /intro/*
    handle @pitch {
        encode zstd gzip
        root * /srv/pitch
        file_server
    }

    handle {
        reverse_proxy 172.19.0.1:8765 {
            header_up X-Forwarded-For {remote_host}
        }
    }
}
