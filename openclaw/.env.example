# ============================================================
# Content Pipeline — Environment Variables
# ============================================================
# Copy this file and fill in your values.
# The agent entrypoint loads /app/config/.env automatically.
# These vars are also needed in the agent's config .env.
# ============================================================

# -------- Feishu (required) --------
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_WEBHOOK_URL=
# FEISHU_NOTIFY_OPEN_ID=

# -------- Vendor LLM (required; Moonshot/Kimi via OpenAI-compatible API) --------
LLM_API_KEY=
LLM_BASE_URL=https://api.moonshot.cn/v1
LLM_MODEL=kimi-k2.6
# The same key under the name openclaw actually resolves — its env-marker
# whitelist accepts OPENAI_API_KEY but NOT LLM_API_KEY. render_env_file
# writes both; keep them in sync when editing by hand.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.moonshot.cn/v1

# -------- Pexels (required for image search) --------
PEXELS_API_KEY=

# -------- MiMo Omni (optional, for image analysis) --------
# XIAOMI_MIMO_API_KEY=

# -------- ComfyUI (optional, skip AI image gen if not set) --------
# COMFYUI_URL=http://127.0.0.1:8188
